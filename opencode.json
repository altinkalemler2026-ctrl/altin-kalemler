      "npx tsc*": "allow",
      "npx next lint*": "allow",
      "node --version": "allow",
      "git push*": "ask",
      "git commit*": "ask",
      "git reset*": "deny",
      "git restore*": "deny",
      "git checkout*": "deny",
      "git clean*": "deny",
      "git rebase*": "deny",
      "supabase db push*": "deny",
      "supabase link*": "deny",
      "supabase login*": "deny",
